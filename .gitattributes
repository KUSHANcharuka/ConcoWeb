# Auto-detect text files and enforce LF line endings in the repository.
# This prevents the "LF will be replaced by CRLF" warnings on Windows.

# Default: treat all files as text and normalize to LF in the repo
* text=auto eol=lf

# Explicitly enforce LF for source code
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.mdx   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.env   text eol=lf
*.env.* text eol=lf
*.lock  text eol=lf

# Shell scripts must use LF
*.sh    text eol=lf

# Windows-specific scripts use CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files — do not touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.svg   binary
*.ico   binary
*.pdf   binary
*.mp4   binary
*.mov   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
