# ---------------------------------------------------------------------------
# Concolabs platform — local environment template
#
# Copy to `.env` (or `.env.local`) and fill in the values.
# Never commit `.env` files with real secrets — only this template.
# When adding env vars, update the schema in `src/env.js` to match.
# ---------------------------------------------------------------------------

# Node runtime
NODE_ENV=development

# Public app URL (used for links, redirects, webhook callbacks)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Neon Postgres (Drizzle)
# Pooled connection string from a Neon dev branch.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------------------------------------------------------------------------
# Clerk — auth
#
# Admin model: treat Concolabs staff as a single Clerk Organization. Members of
# that org are admins. A webhook syncs `publicMetadata.role = "admin"` on join.
# Middleware gates `/admin` on the role flag (not on the active org) so admins
# can switch to a client org for "preview as client" without losing access.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk-hosted sign-in/sign-up URLs — keep defaults unless self-hosted pages move.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Webhook signing secret from Clerk Dashboard → Webhooks. Required — the
# `/api/webhooks/clerk` route uses it to verify svix signatures.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ID of the Concolabs internal Clerk Organization (the staff org). Required —
# membership events on this org promote/demote users to admin via the webhook.
CLERK_CONCOLABS_ORG_ID=org_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Stripe (deferred — keep optional until billing work starts)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Resend (transactional email)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender policy for admin-managed email settings. The sender email saved in the
# database must match one of these verified values before the app will send.
# Comma-separated. Use domains for shared policy and exact emails for exceptions.
RESEND_ALLOWED_FROM_DOMAINS=concolabs.com
RESEND_ALLOWED_FROM_EMAILS=hello@concolabs.com

# ---------------------------------------------------------------------------
# Outbound webhook signing key — used later by the access broker to sign HMAC
# headers when notifying product backends. Optional until that work begins.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
OUTBOUND_WEBHOOK_SIGNING_KEY=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ---------------------------------------------------------------------------
# Cloudflare R2 (project cover upload and future confidential assets)
# Keep optional until storage is configured.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional public asset base URL for intentionally public assets only, such as
# public bucket content exposed through r2.dev or a custom domain.
# Do not point this at `*.r2.cloudflarestorage.com/<bucket>` for confidential
# project files, proposal documents, signatures, or payment proofs. Those
# assets should use signed read URLs instead.
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# DocuSeal (proposal builder/signing)
# Cloud mode:
# - DOCUSEAL_API_BASE_URL=https://api.docuseal.com
# - DOCUSEAL_APP_BASE_URL=https://docuseal.com
# Self-hosted mode:
# - point both values at your deployment origin
# ---------------------------------------------------------------------------
DOCUSEAL_API_BASE_URL=
DOCUSEAL_APP_BASE_URL=
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=

# For DocuSeal test mode embedding, set this to the test-environment admin
# email (for example the admin account that uses the +test suffix).
DOCUSEAL_TEST_USER_EMAIL=
